DASHSCOPE_API_KEY=sk-xxx

# 本地验收支付；生产环境严禁启用 sandbox。
PIXELDOODLE_ENV=development
PIXELDOODLE_SANDBOX_PAYMENT_ENABLED=true
PIXELDOODLE_SANDBOX_PAYMENT_SECRET=replace-with-a-local-random-secret

# 后端与每块 ESP32 固件必须配置相同的设备授权密钥。
PIXELDOODLE_DEVICE_ACTIVATION_SECRET=replace-with-a-per-device-secret
PIXELDOODLE_DEVICE_LOCK_ENABLED=true
# 当前仓库的设备侧付费授权只覆盖 BLE；未部署可验签的 WiFi 接收器前保持 false。
PIXELDOODLE_WIFI_DEVICE_AUTH_ENABLED=false

# 管理接口（生产设备登记、WiFi 注册、结算恢复）使用，至少 16 字符。
PIXELDOODLE_ADMIN_KEY=replace-with-a-long-admin-key

# 私有云、分润台账和设备登记默认共用此 SQLite 数据库。
PIXELDOODLE_BUSINESS_DB_PATH=data/pixeldoodle-business.db
PIXELDOODLE_MERCHANT_SHARE_BPS=8000
PIXELDOODLE_PLATFORM_ACCOUNT_ID=platform
PIXELDOODLE_AUTO_SETTLE=true
