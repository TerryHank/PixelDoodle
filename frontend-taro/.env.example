# H5 / Tauri Android 使用的 CloudBase 环境。复制本文件为 .env 后填写。
TARO_APP_CLOUDBASE_ENV_ID=
TARO_APP_CLOUDBASE_REGION=ap-shanghai

# 可选：仅允许填写 CloudBase Web Publishable Key（客户端公开 Key）。
# 它不是服务端密钥，只用于匿名测试；生产付费链路必须使用已验证用户登录。
TARO_APP_CLOUDBASE_ACCESS_KEY=

# 严禁在本文件或任何 TARO_APP_* 变量中填写 DASHSCOPE_API_KEY、SecretId、
# SecretKey、CloudBase 服务端密钥或移动应用私钥。DASHSCOPE_API_KEY 只放云函数环境变量。
